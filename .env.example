# Copy to .env (for `vercel dev`) and/or set these as Environment Variables in the Vercel
# project dashboard (Settings → Environment Variables) before deploying.

# Password for the owner/editor login at /login. Required.
OWNER_PASSWORD=

# Shared access code for the client-facing Presentation section at /presentation/login. Anyone
# with this code can view every published model — there is no per-client scoping. Required.
PRESENTATION_ACCESS_CODE=

# Secret used to sign session cookies (api/_lib/session.ts). Use a long random string — e.g.
# `openssl rand -base64 32`. Required. Rotating it immediately invalidates all existing sessions.
SESSION_SECRET=

# Set automatically by Vercel once you enable Blob storage on this project (Storage tab → Create
# Database → Blob). Without it, published snapshots fall back to a local-filesystem stub under
# .data/ (see api/_lib/storage.ts) — fine for local testing, not for a real deployment, since
# serverless function filesystems aren't persistent or shared across invocations.
BLOB_READ_WRITE_TOKEN=
